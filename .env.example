# Copy this template to .env and fill every empty value before starting services.
# NETHERLINK_ENV below is the runtime mode value; .env is the local values file.
# Do not commit .env. Generate secrets with a password manager or:
#   openssl rand -hex 32

NETHERLINK_ENV=local
NETHERLINK_HTTP_ADDR=:8080

NETHERLINK_AUTH_TOKEN_SECRET=
NETHERLINK_AUTH_ACCESS_TOKEN_TTL=15m
NETHERLINK_AUTH_REFRESH_TOKEN_TTL=720h

NETHERLINK_POSTGRES_HOST=localhost
NETHERLINK_POSTGRES_PORT=5432
NETHERLINK_POSTGRES_DB=netherlink
NETHERLINK_POSTGRES_USER=netherlink_app
NETHERLINK_POSTGRES_PASSWORD=
NETHERLINK_POSTGRES_SSLMODE=disable

NETHERLINK_REDIS_HOST=localhost
NETHERLINK_REDIS_PORT=6379
NETHERLINK_REDIS_USERNAME=
NETHERLINK_REDIS_PASSWORD=
NETHERLINK_REDIS_DB=0

NETHERLINK_REALTIME_EVENT_RETENTION=168h
NETHERLINK_REALTIME_EVENT_CLEANUP_INTERVAL=1h
NETHERLINK_REALTIME_EVENT_CLEANUP_BATCH=5000

NETHERLINK_OBJECT_STORAGE_PROVIDER=minio
NETHERLINK_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
NETHERLINK_OBJECT_STORAGE_INTERNAL_ENDPOINT=http://localhost:9000
NETHERLINK_OBJECT_STORAGE_ACCESS_KEY=
NETHERLINK_OBJECT_STORAGE_SECRET_KEY=
NETHERLINK_OBJECT_STORAGE_USE_SSL=false
NETHERLINK_OBJECT_STORAGE_PRESIGN_TTL=10m
NETHERLINK_OBJECT_STORAGE_PUBLIC_BUCKET=netherlink-public
NETHERLINK_OBJECT_STORAGE_PROTECTED_BUCKET=netherlink-protected
NETHERLINK_OBJECT_STORAGE_PRIVATE_BUCKET=netherlink-private
NETHERLINK_OBJECT_STORAGE_TMP_BUCKET=netherlink-tmp
NETHERLINK_FILE_USER_QUOTA_BYTES=10737418240

NETHERLINK_AI_PROVIDER=disabled
NETHERLINK_AI_API_KEY=
NETHERLINK_AI_BASE_URL=
NETHERLINK_AI_DEFAULT_MODEL=
NETHERLINK_AI_TITLE_MODEL=
NETHERLINK_AI_THINKING_TYPE=
NETHERLINK_AI_REASONING_EFFORT=
NETHERLINK_AI_MAX_CONTEXT_TOKENS=0
NETHERLINK_AI_REQUEST_TIMEOUT=1m

NETHERLINK_MINIO_API_PORT=9000
NETHERLINK_MINIO_CONSOLE_PORT=9001
